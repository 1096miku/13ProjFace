
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# > Plan C / D6 实验：加上巴法云 MQTT 客户端后，内部 RAM 低水位掉到 6167 B（D5 基线 9267 B）。
# > 实测一个 esp-mqtt 客户端独占 7768 B 内部 RAM（4096 任务栈 + ~3.7 KB outbox 等），
# > 我们自己的代码只花 ~750 B（队列/栈都显式 PSRAM）。这里把"小于此值一律进内部堆"的门槛
# > 从 2048 降到 512，让 513~2048 B 的分配倾向落 PSRAM，看能回收多少。
# ! 回退方法：把这一行改回 2048（原值）并 touch sdkconfig 重新构建。
# ! 风险：DMA/内部专用分配不受本项影响（它们显式带 MALLOC_CAP_DMA/INTERNAL），
# ! 但若出现"cache 关闭时分配 PSRAM"类崩溃，先回退这一行。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- 语音：离线命令词走 MultiNet（Plan C / D6）----
# > 与 CONFIG_USE_AFE_WAKE_WORD 是同一个 choice，切过去后唤醒词由 MN 拼音识别承担。
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="ni hao xiao zhi"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="你好小智"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20
# > 打包进 assets/srmodels.bin（约 2.67 MB，assets 余量约 0.48 MB，够）
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
# ! 这行在 USE_CUSTOM_WAKE_WORD 下**不生效**：build_default_assets.py:853-856 只在
# ! ESP/AFE 唤醒词下打包 wakenet，切到 MN 后模型包里只有 mn7_cn（设计文档 §6.1 那句
# ! "wn9 仍留在模型包里"是错的，见 docs/BUGS.md）。留着是为了回退时不用再改回来。
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y
